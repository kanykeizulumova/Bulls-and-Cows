{
    "name": "bulls-and-cows",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "build": "tsc",
        "watch": "tsc --watch",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "prepare": "husky"
    },
    "devDependencies": {
        "@eslint/js": "^9.20.0",
        "@types/node": "^22.13.0",
        "eslint": "^9.20.0",
        "eslint-config-prettier": "^10.0.1",
        "husky": "^9.1.7",
        "lint-staged": "^15.4.3",
        "prettier": "^3.5.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.24.0",
        "vitest": "^3.0.5"
    },
    "lint-staged": {
        "*.{ts,js}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,css,md,html}": [
            "prettier --write"
        ]
    }
}
